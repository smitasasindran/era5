__pycache__/
*.pyc
.idea/

# Generated by scripts/run_pipeline.py -- deterministic from whichever
# corpus was last passed to it (data/corpus/small_shard.parquet or
# data/corpus/toy_corpus.parquet), rebuilt fresh each run, not checked in.
# data/corpus/ itself IS checked in -- it holds inputs, not outputs.
data/tokenizer/
data/shards/
data/manifests/

# Generated by scripts/build_eval_registry.py -- fully reproducible from
# configs/eval_registry*.yaml + the corpus, so not checked in either, even
# though (unlike the three above) it's not cleared/rebuilt by
# run_pipeline.py itself. The eventual run_demo.py must call
# build_eval_registry.py for each profile before run_pipeline.py, or the
# firewall will (correctly, but unhelpfully for the demo) find an empty
# registry and block nothing.
data/eval_registry/

# Generated by scripts/compile_mixture.py -- deterministic from
# configs/curriculum*.yaml + whichever corpus's manifests are currently
# built under data/manifests/. Like that config's manifests_dir, this reads
# whatever corpus was last built there -- see IMPLEMENTATION_NOTES.md §3.
data/mixture_schedule*.json

# Generated by scripts/run_opus_selection.py -- deterministic from
# data/manifests/ + configs/opus*.yaml + whichever model snapshot
# (checkpoint_path, or a fresh seed) it's pointed at. Not reproducible
# from static config alone the same way the tokenizer/schedule are (a
# further-trained model scores differently), which is exactly why this
# artifact is hash-pinned rather than silently re-run later.
data/opus_decisions*.json

# Will hold the full-pipeline demo output once later stages exist.
submission_artifacts/
